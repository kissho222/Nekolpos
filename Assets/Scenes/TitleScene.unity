  m_text: "\u5E73\u7D20\u3088\u308A\u5F53\u30B5\u30FC\u30D3\u30B9\u3092\u3054\u5229\u7528\u3044\u305F\u3060\u304D\u3001\u8AA0\u306B\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u3002\n\r\n\u73FE\u5728\u3001\u914D\u9001\u696D\u52D9\u3092\u62C5\u5F53\u3059\u308B\u30C9\u30E9\u30A4\u30D0\u30FC\u3068\u306E\u96C7\u7528\u6761\u4EF6\u304A\u3088\u3073\u52B4\u50CD\u74B0\u5883\u306B\u95A2\u3059\u308B\u5354\u8B70\u306B\u4F34\u3044\u3001\u4E00\u90E8\u5730\u57DF\u306B\u304A\u3044\u3066\u5927\u898F\u6A21\u306A\u696D\u52D9\u505C\u6B62\u304C\u767A\u751F\u3057\u3066\u304A\u308A\u307E\u3059\u3002\r\n\u5F53\u793E\u3067\u306F\u3001\u914D\u9001\u30B9\u30BF\u30C3\u30D5\u304C\u5B89\u5FC3\u3057\u3066\u696D\u52D9\u306B\u5F93\u4E8B\u3067\u304D\u308B\u74B0\u5883\u306E\u6574\u5099\u3092\u91CD\u8981\u306A\u8AB2\u984C\u3068\u8A8D\u8B58\u3057\u3066\u304A\u308A\u3001\u73FE\u5728\u3001\u96C7\u7528\u5951\u7D04\u3084\u52E4\u52D9\u4F53\u7CFB\u3092\u542B\u3080\u904B\u55B6\u4F53\u5236\u5168\u4F53\u306E\u898B\u76F4\u3057\u3092\u9032\u3081\u3066\u304A\u308A\u307E\u3059\u3002\r\n\u3053\u308C\u306B\u4F34\u3044\u3001\u5B89\u5168\u304B\u3064\u5B89\u5B9A\u3057\u305F\u914D\u9001\u4F53\u5236\u3092\u78BA\u4FDD\u3067\u304D\u308B\u307E\u3067\u306E\u9593\u3001\u30C7\u30EA\u30D0\u30EA\u30FC\u30B5\u30FC\u30D3\u30B9\u306E\u55B6\u696D\u3092\u4E00\u6642\u4F11\u6B62\u3055\u305B\u3066\u3044\u305F\u3060\u304F\u3053\u3068\u3068\u306A\u308A\u307E\u3057\u305F\u3002\r\n\u65E5\u9803\u3088\u308A\u3054\u5229\u7528\u3044\u305F\u3060\u3044\u3066\u3044\u308B\u304A\u5BA2\u69D8\u306B\u306F\u3001\u591A\u5927\u306A\u308B\u3054\u4E0D\u4FBF\u3068\u3054\u8FF7\u60D1\u3092\u304A\u304B\u3051\u3044\u305F\u3057\u307E\u3059\u3053\u3068\u3092\u3001\u6DF1\u304F\u304A\u8A6B\u3073\u7533\u3057\u4E0A\u3052\u307E\u3059\u3002\r\n\u95A2\u4FC2\u8005\u3068\u306E\u5354\u8B70\u3092\u7D99\u7D9A\u3057\u3001\u3088\u308A\u826F\u3044\u52B4\u50CD\u74B0\u5883\u3068\u30B5\u30FC\u30D3\u30B9\u4F53\u5236\u306E\u69CB\u7BC9\u3092\u9032\u3081\u305F\u3046\u3048\u3067\u3001\u4E00\u65E5\u3082\u65E9\u3044\u55B6\u696D\u518D\u958B\u3092\u76EE\u6307\u3057\u3066\u307E\u3044\u308A\u307E\u3059\u3002\r\n\u55B6\u696D\u518D\u958B\u306E\u6642\u671F\u306B\u3064\u304D\u307E\u3057\u3066\u306F\u3001\u6C7A\u5B9A\u6B21\u7B2C\u3042\u3089\u305F\u3081\u3066\u304A\u77E5\u3089\u305B\u3044\u305F\u3057\u307E\u3059\u3002\r\n\u4F55\u5352\u3054\u7406\u89E3\u8CDC\u308A\u307E\u3059\u3088\u3046\u3001\u3088\u308D\u3057\u304F\u304A\u9858\u3044\u7533\u3057\u4E0A\u3052\u307E\u3059\u3002"
