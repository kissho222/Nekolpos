      "content": "using System.Reflection;\nusing System.Security.Cryptography;\nusing System.Text.Json;\nusing Nekolpos.System;\nusing UnityEngine;\n\nvar records = new List<object>();\nint passed = 0;\nRun(\"central_mallet_only\", new(500f, 0f), new(110f, 0f), new(600f, 0f), false, \"PlayerMallet\");\nRun(\"top_wall_only\", new(300f, 531.9f), new(0f, 110f), null, false, \"Wall\");\nRun(\"top_mallet_then_wall\", new(500f, 520f), new(0f, -110f), new(500f, 450f), false, \"PlayerMallet\", \"Wall\");\nRun(\"bottom_mallet_then_wall\", new(500f, -520f), new(0f, 110f), new(500f, -450f), false, \"PlayerMallet\", \"Wall\");\nRun(\"top_continuing_overlap_inward\", new(500f, 520f), new(0f, -110f), new(500f, 450f), true);\nRun(\"bottom_continuing_overlap_inward\", new(500f, -520f), new(0f, 110f), new(500f, -450f), true);\nRun(\"top_outside_inward\", new(300f, 533f), new(0f, -110f), null, false);\nRun(\"bottom_outside_inward\", new(300f, -533f), new(0f, 110f), null, false);\nRun(\"right_outside_inward\", new(893f, 500f), new(-110f, 0f), null, false);\nRun(\"left_outside_inward\", new(-893f, 500f), new(110f, 0f), null, false);\n\nstring sourcePath = Path.GetFullPath(Path.Combine(AppContext.BaseDirectory, \"../../../../../Assets/Scripts/System/TabletHockeyMatch.cs\"));\n// Output and source are both workspace-local; this audit never starts Unity or touches saves.\nstring outputPath = Path.GetFullPath(Path.Combine(AppContext.BaseDirectory, \"../../../results.json\"));\nvar report = new\n{\n    passed,\n    failed = 10 - passed,\n    source = \"Assets/Scripts/System/TabletHockeyMatch.cs\",\n    sourceSha256 = Convert.ToHexString(SHA256.HashData(File.ReadAllBytes(sourcePath))).ToLowerInvariant(),\n    environment = \".NET 9, unmodified source linked by csproj; managed Vector2/Mathf arithmetic shim\",\n    limitations = new[] { \"No Unity runtime or native API\", \"No real gameplay, AudioSource, Mixer, audible output, or Player Build tested\", \"Fixture states supplied by reflection; finite cases only\" },\n    cases = records\n};\nFile.WriteAllText(outputPath, JsonSerializer.Serialize(report, new JsonSerializerOptions { WriteIndented = true }));\nConsole.WriteLine(JsonSerializer.Serialize(report, new JsonSerializerOptions { WriteIndented = true }));\nEnvironment.ExitCode = passed == 10 ? 0 : 1;\n\nvoid Run(string name, Vector2 initialPuck, Vector2 initialVelocity, Vector2? mallet, bool alreadyTouching, params string[] expected)\n{\n    var match = new TabletHockeyMatch(new Vector2(1872f, 1152f), 44f, 65f, 384f, 110f, 25f);\n    Set(\"Puck\", initialPuck);\n    Set(\"Velocity\", initialVelocity);\n    typeof(TabletHockeyMatch).GetField(\"playerTouching\", BindingFlags.Instance | BindingFlags.NonPublic)!.SetValue(match, alreadyTouching);\n    var impacts = new List<object>();\n    var actual = new List<string>();\n    match.Impact += (kind, point) =>\n    {\n        actual.Add(kind.ToString());\n        impacts.Add(new { kind = kind.ToString(), point = V(point), puck = V(match.Puck), velocity = V(match.Velocity) });\n    };\n    match.Step(0.004f, mallet ?? Vector2.zero, mallet.HasValue, Vector2.zero, false);\n    bool success = actual.SequenceEqual(expected);\n    if (success) passed++;\n    records.Add(new { name, success, initialPuck = V(initialPuck), initialVelocity = V(initialVelocity), mallet = mallet.HasValue ? V(mallet.Value) : null, alreadyTouching, expected, actual, impacts, finalPuck = V(match.Puck), finalVelocity = V(match.Velocity) });\n    void Set(string property, object value) => typeof(TabletHockeyMatch).GetProperty(property)!.SetValue(match, value);\n}\nobject V(Vector2 value) => new { x = value.x, y = value.y };\n"
    },
